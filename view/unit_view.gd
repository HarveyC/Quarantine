extends Node3D
## Visual for one unit. Holds its own *displayed* copy of hp / infection / statuses,
## updated only by the event player, so the 3D view and HUD can lag behind the
## rules state while animations play.
##
## Models come from assets/models (generated by tools/gen_models.py, loaded by
## ModelKit) as a jointed rig: hips, legs with knees, torso, head, arms with elbows,
## weapon. They are animated procedurally in `tick`: idle breathing, walk cycle, aim
## (arms follow the weapon by two-bone IK), recoil, hit reactions, hunker crouch,
## death fall. Infection shows as spreading veins (character shader) and growths
## that break out per tier. `tick` runs on the event player's clock, so slow motion
## in a shot cinematic slows the bodies too.

signal stepped   # a foot landed while walking (for footstep sounds)

const Palette := preload("res://view/palette.gd")
const Board := preload("res://view/board.gd")

const ModelKit := preload("res://view/model_kit.gd")
const TURN_SPEED := 9.0   # radians per second

var unit_id := 0
var kind := ""
var display_name := ""
var owner_player := -1
var is_soldier := true
var cell := Vector2i.ZERO
var hp := 1
var max_hp := 1
var infection := 0
var tier := 0
var overwatch := false
var hunkered := false
var lapsed := false
var turned := false
var dead := false

var _body: Node3D        # yaw only
var _rig: Node3D         # bob, lean, knockback, lunge
var _model: Node3D
var _hips: Node3D
var _torso: Node3D
var _head: Node3D
var _legs: Array[Node3D] = []
var _knees: Array[Node3D] = []
var _arm_r: Node3D
var _arm_l: Node3D
var _elbow_r: Node3D
var _elbow_l: Node3D
var _gun: Node3D
var _support: Node3D     # off-hand grip on the weapon
var _muzzle: Node3D
var _sac: Node3D         # spitter's glowing back sac
var _glow: OmniLight3D
var _mats := {}          # role -> ShaderMaterial (this unit's own copies)
var _growths := []       # [stage, MeshInstance3D] infection growths
var _shown_stage := 0
var _popping: Array[Node3D] = []   # growths bursting out during pulse_infection
var _yaw := 0.0
var _yaw_target := 0.0
var _hip_y := 0.8
var _torso_y := 0.08
var _upper_len := 0.27
var _hp_sprite: Sprite3D
var _status_label: Label3D
var _class_label: Label3D
var _infection_ring: MeshInstance3D
var _infection_mat: StandardMaterial3D
var _select_ring: MeshInstance3D
var _target_ring: MeshInstance3D
var _overlays_on := true
var _flash := 0.0
var _flash_color := Color.WHITE

# animation state
var _time := 0.0
var _moving := false
var _walk := 0.0
var _stride := 0.0
var _aim := 0.0
var _aim_target := 0.0
var _recoil := 0.0
var _hit := 0.0
var _hit_dir := Vector3.ZERO
var _lunge := 0.0
var _crouch := 0.0
var _death := 0.0
var _fall_dir := Vector3.BACK


func build(u: Unit) -> void:
	unit_id = u.id
	kind = u.kind
	display_name = u.display_name
	owner_player = u.owner_player
	is_soldier = u.team == Types.Team.PLAYER
	hp = u.hp
	max_hp = u.max_hp
	infection = u.infection
	tier = Infection.tier(u.infection)
	lapsed = u.status.get("lapsed", false)
	name = "Unit%d" % unit_id
	_time = float(unit_id) * 1.37
	_body = Node3D.new()
	add_child(_body)
	_rig = Node3D.new()
	_body.add_child(_rig)
	_build_model()
	_build_rings()
	_build_labels()
	set_cell(u.pos)
	_refresh_all()
	_pose()


# --- model -------------------------------------------------------------------

func _build_model() -> void:
	_model = ModelKit.instantiate(kind, is_soldier)
	_rig.add_child(_model)
	_mats = ModelKit.apply_materials(_model, owner_player, is_soldier)
	_hips = ModelKit.find(_model, "hips")
	_torso = ModelKit.find(_model, "torso")
	_head = ModelKit.find(_model, "head")
	_legs = [ModelKit.find(_model, "leg_r"), ModelKit.find(_model, "leg_l")]
	_knees = [ModelKit.find(_model, "knee_r"), ModelKit.find(_model, "knee_l")]
	_arm_r = ModelKit.find(_model, "arm_r")
	_arm_l = ModelKit.find(_model, "arm_l")
	_elbow_r = ModelKit.find(_model, "elbow_r")
	_elbow_l = ModelKit.find(_model, "elbow_l")
	_gun = ModelKit.find(_model, "gun")
	_support = ModelKit.find(_model, "support")
	_muzzle = ModelKit.find(_model, "muzzle")
	_sac = ModelKit.find(_model, "sac")
	if _gun == null:
		_gun = _head
	if _muzzle == null:
		_muzzle = _head
	_hip_y = _hips.position.y
	_torso_y = _torso.position.y
	_upper_len = _elbow_r.position.length()
	_growths = ModelKit.growths(_model)
	_glow = OmniLight3D.new()
	_glow.light_color = Palette.TEAL
	_glow.shadow_enabled = false
	_rig.add_child(_glow)
	if is_soldier:
		_glow.omni_range = 2.2
		_glow.light_energy = 0.0
		_glow.position = Vector3(0, 1.1, 0)
		_glow.visible = false
	else:
		_glow.omni_range = 2.6 if kind == "spitter" else 2.0
		_glow.light_energy = _enemy_glow()
		_glow.position = Vector3(0, 0.95, 0.1)
		_set_veins(0.62)


func _enemy_glow() -> float:
	return 1.1 if kind == "spitter" else 0.7


func _set_veins(k: float) -> void:
	for m in _mats.values():
		if m.get_meta("role") in ModelKit.VEINABLE:
			m.set_shader_parameter("infection", k)


func _build_rings() -> void:
	_infection_mat = Palette.emissive(Palette.TEAL, 1.0)
	_infection_ring = Palette.ring(0.34, 0.44, _infection_mat)
	_infection_ring.position.y = 0.03
	_infection_ring.scale.y = 0.3
	add_child(_infection_ring)
	_select_ring = Palette.ring(0.42, 0.48, Palette.overlay(Color(1, 0.86, 0.5, 0.95)))
	_select_ring.position.y = 0.04
	_select_ring.scale.y = 0.2
	_select_ring.visible = false
	add_child(_select_ring)
	_target_ring = Palette.ring(0.44, 0.52, Palette.overlay(Color(Palette.DANGER, 0.95)))
	_target_ring.position.y = 0.05
	_target_ring.scale.y = 0.2
	_target_ring.visible = false
	add_child(_target_ring)


func _build_labels() -> void:
	_hp_sprite = Sprite3D.new()
	_hp_sprite.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	_hp_sprite.no_depth_test = true
	_hp_sprite.pixel_size = 0.012
	_hp_sprite.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	_hp_sprite.position.y = 1.95
	add_child(_hp_sprite)
	var tag := Palette.class_letter(kind)
	if is_soldier:
		tag += " P%d" % (owner_player + 1)
	var col := Palette.player_ui(owner_player) if is_soldier else Palette.TEAL
	_class_label = Palette.label3d(tag, 44, col)
	_class_label.position.y = 2.3
	add_child(_class_label)
	_status_label = Palette.label3d("", 28, Palette.AMBER)
	_status_label.position.y = 1.75
	add_child(_status_label)


# --- display state ----------------------------------------------------------

func label() -> String:
	if is_soldier and owner_player >= 0:
		return "%s (P%d)" % [display_name, owner_player + 1]
	return display_name


func set_cell(c: Vector2i) -> void:
	cell = c
	position = Board.cell_to_world(c)


## Turns the body to face `world`: smoothly in `tick`, or at once with `instant`.
func face_towards(world: Vector3, instant := false) -> void:
	var d := world - position
	if Vector2(d.x, d.z).length() > 0.01:
		_yaw_target = atan2(d.x, d.z)
		if instant:
			set_yaw(_yaw_target)


func set_yaw(yaw: float) -> void:
	_yaw = yaw
	_yaw_target = yaw
	_body.rotation.y = yaw


func facing() -> Vector3:
	return Vector3(sin(_body.rotation.y), 0, cos(_body.rotation.y))


func set_hp(value: int) -> void:
	hp = value
	_refresh_hp()


func set_infection(value: int, t: int) -> void:
	infection = value
	tier = t
	_refresh_infection()


func set_statuses(ow: bool, hk: bool) -> void:
	overwatch = ow
	hunkered = hk
	_refresh_status()


func set_lapsed(on: bool) -> void:
	lapsed = on
	_refresh_status()


func set_turned() -> void:
	turned = true
	lapsed = false
	var dead_col := Palette.player_body(owner_player).lerp(Palette.ENEMY_BODY, 0.7)
	for role in ["cloth_team", "cloak_team", "armor_team"]:
		if _mats.has(role):
			_mats[role].set_shader_parameter("albedo", dead_col.darkened(0.1 if role == "cloth_team" else 0.3))
	_class_label.modulate = Palette.TEAL
	_glow.visible = true
	_glow.light_energy = 1.0
	_refresh_infection()
	_refresh_status()


func set_selected(on: bool) -> void:
	_select_ring.visible = on


func set_targeted(on: bool) -> void:
	_target_ring.visible = on


## Hides the floating HP / labels / rings, e.g. during a shot cinematic.
func set_overlays_visible(on: bool) -> void:
	_overlays_on = on
	for n in [_hp_sprite, _class_label, _status_label]:
		n.visible = on and not dead
	if not on:
		_select_ring.visible = false
		_target_ring.visible = false


func flash(color: Color) -> void:
	_flash = 1.0
	_flash_color = color
	_apply_flash()


# --- animation controls (called by the event player) --------------------------

func set_moving(on: bool) -> void:
	_moving = on


## 0 = weapon at low ready, 1 = shouldered and aimed.
func set_aim(target: float) -> void:
	_aim_target = target


func aim_now(k: float) -> void:
	_aim = k
	_aim_target = k


func recoil(strength := 1.0) -> void:
	_recoil = strength


## Knock the body away from `from_world`.
func hit_react(from_world: Vector3, strength := 1.0) -> void:
	var d := position - from_world
	d.y = 0.0
	_hit_dir = d.normalized() if d.length() > 0.01 else -facing()
	_fall_dir = _hit_dir
	_hit = strength


## Melee lunge 0..1 (forward strike).
func set_lunge(k: float) -> void:
	_lunge = k


func muzzle_world() -> Vector3:
	return _to_world(_muzzle, Vector3.ZERO)


func chest_world() -> Vector3:
	return position + Vector3(0, 1.05 if is_soldier else 0.85, 0)


func head_world() -> Vector3:
	return position + Vector3(0, 1.5, 0)


## World position of a point in `node`'s local space, computed from the transform
## chain so it works out of the tree (tests) too.
func _to_world(node: Node3D, local: Vector3) -> Vector3:
	var p := local
	var n: Node = node
	while n != null and n != self:
		p = (n as Node3D).transform * p
		n = n.get_parent()
	return transform * p


## Advances procedural animation and fades; called by the event player's clock.
func tick(delta: float) -> void:
	_time += delta
	if _yaw != _yaw_target and not dead:
		_yaw = rotate_toward(_yaw, _yaw_target, delta * TURN_SPEED)
		_body.rotation.y = _yaw
	if _flash > 0.0:
		_flash = maxf(0.0, _flash - delta * 3.0)
		_apply_flash()
	_walk = move_toward(_walk, 1.0 if _moving else 0.0, delta * 6.0)
	if _walk > 0.0:
		var before := sin(_stride)
		_stride += delta * (13.0 if kind == "runner" else 11.0)
		if signf(sin(_stride)) != signf(before) and _moving:
			stepped.emit()
	_aim = move_toward(_aim, maxf(_aim_target, 0.55 if overwatch else 0.0), delta * 5.0)
	_recoil = move_toward(_recoil, 0.0, delta * 7.0)
	_hit = move_toward(_hit, 0.0, delta * 3.5)
	_crouch = move_toward(_crouch, 1.0 if hunkered else 0.0, delta * 4.0)
	if _sac != null:
		var s := 1.0 + sin(_time * 3.0) * 0.06 + _aim * 0.12 - _recoil * 0.2
		_sac.scale = Vector3(s, s * 0.95, s)
	if _glow != null and _glow.visible and not is_soldier:
		_glow.light_energy = _enemy_glow() * (0.8 + 0.2 * sin(_time * 4.0 + unit_id))
	_pose()


func _pose() -> void:
	if _hips == null or _death > 0.0:
		return
	var feral := not is_soldier or turned
	var breathe := sin(_time * 2.1)
	var sw := sin(_stride) * _walk
	var bob := absf(cos(_stride)) * 0.05 * _walk
	var twitch := sin(_time * 13.0) * sin(_time * 2.3) * 0.08 if feral else 0.0
	# legs: stride swing, knee bend on the back swing, crouch when hunkered;
	# the infected stand in a permanent half-crouch
	var bent := 0.3 if not is_soldier else 0.0
	for i in 2:
		var s := sw if i == 0 else -sw
		_legs[i].rotation.x = s * 0.6 - _crouch * 0.9 - bent * 0.6
		_knees[i].rotation.x = maxf(0.0, -s) * 0.9 + _crouch * 1.6 + bent
		_legs[i].rotation.z = 0.04 * (1.0 if i == 0 else -1.0) * (1.0 - _walk)   # slight stance
	_hips.position.y = _hip_y - _crouch * 0.28 - bent * 0.06 + bob
	_hips.rotation.y = sw * 0.12
	# rig: knockback, lunge, idle sway
	var fwd := Vector3(0, 0, 1)
	var local_hit := _body.basis.inverse() * _hit_dir if _hit > 0.0 else Vector3.ZERO
	_rig.position = local_hit * 0.22 * _hit + fwd * _lunge * 0.55
	_rig.rotation.z = sin(_time * 0.8) * 0.015
	# torso: lean into walk / lunge, recoil kick, hit twist, breathing
	var lean := 0.12 * _walk + 0.5 * _lunge + _crouch * 0.35 - _recoil * 0.12
	if feral:
		lean += (0.4 if not is_soldier else 0.2) + twitch - _aim * 0.25
	_torso.rotation.x = lean - local_hit.z * 0.4 * _hit
	_torso.rotation.z = local_hit.x * 0.4 * _hit
	_torso.rotation.y = -sw * 0.15
	_torso.position.y = _torso_y + breathe * 0.008
	var look := sin(_time * 0.45 + unit_id) * (0.25 if not feral else 0.4) * (1.0 - _aim)
	_head.rotation.y = look
	if is_soldier:
		_head.rotation.x = -lean * 0.6 + sin(_time * 0.7) * 0.05 + twitch * 2.0
		_pose_weapon(lean, sw)
	else:
		# rear back to spit (aim), lurch forward on the release (recoil)
		_head.rotation.x = -lean * 0.7 + twitch * 2.0 - _aim * 0.45 + _recoil * 0.6
		# claws swing while walking, raise on lunge, elbows always cocked
		_arm_r.rotation.x = -0.3 + sw * 0.7 - _lunge * 1.6 + twitch
		_arm_l.rotation.x = -0.3 - sw * 0.7 - _lunge * 1.2 - twitch
		_arm_r.rotation.z = -0.22
		_arm_l.rotation.z = 0.22
		_elbow_r.rotation.x = -0.5 - maxf(0.0, -sw) * 0.4 - _lunge * 0.3 + _lunge * _lunge * 0.6
		_elbow_l.rotation.x = -0.5 - maxf(0.0, sw) * 0.4 - _lunge * 0.5


## Weapon from low ready (muzzle down and across the body) to shouldered, with both
## hands placed on it by IK.
func _pose_weapon(lean: float, sw: float) -> void:
	var a := _aim
	_gun.position = Vector3(lerpf(-0.06, -0.12, a), lerpf(0.26, 0.42, a) + sw * 0.01, lerpf(0.2, 0.22, a) - _recoil * 0.07)
	_gun.rotation = Vector3(lerpf(0.42, -lean, a) - _recoil * 0.25, lerpf(0.75, 0.0, a), lerpf(-0.45, 0.0, a))
	_reach(_arm_r, _elbow_r, _gun.transform * Vector3(0, -0.035, -0.01), Vector3(-1.0, -0.8, -0.5))
	var off := _gun.transform * (_support.position + Vector3(0, -0.03, 0)) if _support != null else _gun.transform * Vector3(0, 0, 0.3)
	_reach(_arm_l, _elbow_l, off, Vector3(1.0, -1.0, -0.2))


## Two-bone IK in the torso's space: aims the upper arm and forearm so the hand lands
## on `target`; the elbow bends towards `pole`. Limb meshes hang along their joint's -Y.
func _reach(arm: Node3D, elbow: Node3D, target: Vector3, pole: Vector3) -> void:
	var s := arm.position
	var a := _upper_len
	var b := ModelKit.FOREARM
	var to := target - s
	if to.length() < 0.001:
		return
	var dir := to.normalized()
	var d := clampf(to.length(), absf(a - b) + 0.01, a + b - 0.002)
	var cos_a := clampf((a * a + d * d - b * b) / (2.0 * a * d), -1.0, 1.0)
	var bend := (pole - dir * pole.dot(dir)).normalized()
	var e := s + (dir * cos_a + bend * sqrt(1.0 - cos_a * cos_a)) * a
	var upper := _limb_basis(e - s, bend)
	arm.basis = upper
	elbow.basis = upper.inverse() * _limb_basis(s + dir * d - e, bend)


static func _limb_basis(along: Vector3, bend: Vector3) -> Basis:
	var y := -along.normalized()
	var z := -(bend - y * bend.dot(y)).normalized()
	return Basis(y.cross(z), y, z)


func _apply_flash() -> void:
	for m in _mats.values():
		if not (m.get_meta("role") in ModelKit.GLOWING):
			m.set_shader_parameter("flash", _flash * 0.9)
			m.set_shader_parameter("flash_color", _flash_color)


## Death animation progress 0..1: fall away from the killing blow, then sink.
## Infected collapse and dissolve into the ground.
func set_death_progress(t: float) -> void:
	dead = t > 0.0
	_death = t
	var fall := minf(t * 1.7, 1.0)
	fall = 1.0 - pow(1.0 - fall, 3.0)
	var local_dir := _body.basis.inverse() * _fall_dir
	# tip over around the axis perpendicular to the fall direction
	var axis := Vector3(local_dir.z, 0, -local_dir.x).normalized()
	if axis.length() < 0.5:
		axis = Vector3.RIGHT
	_rig.basis = Basis(axis, fall * PI * 0.48)
	_rig.position = local_dir * fall * 0.35 + Vector3(0, lerpf(0.0, -0.9, maxf(0.0, t - 0.55) / 0.45), 0)
	if _knees.size() == 2:
		_knees[0].rotation.x = fall * 1.2
		_knees[1].rotation.x = fall * 0.4
	if _glow != null:
		_glow.light_energy *= 1.0 - t * 0.5
	for n in [_hp_sprite, _class_label, _status_label, _infection_ring, _select_ring, _target_ring]:
		n.visible = n.visible and t < 0.3
	if t >= 1.0:
		visible = false


func pulse_infection(t: float) -> void:
	_infection_ring.visible = true
	var s := 1.0 + sin(t * PI) * 0.5
	_infection_ring.scale = Vector3(s, 0.3, s)
	if _glow != null:
		_glow.visible = true
		_glow.light_energy = maxf(_glow.light_energy, sin(t * PI) * 2.0)
	# growths of a newly reached tier burst out
	var pop := 1.0 - pow(1.0 - clampf(t * 1.4, 0.0, 1.0), 3.0)
	for n in _popping:
		n.scale = Vector3.ONE * (maxf(0.02, pop * 1.08) if t < 1.0 else 1.0)
	if t >= 1.0:
		_popping.clear()
		_refresh_infection()


func _refresh_all() -> void:
	_refresh_hp()
	_refresh_infection()
	_refresh_status()


func _refresh_hp() -> void:
	var pip_w := 6
	var gap := 2
	var w := maxi(1, max_hp * (pip_w + gap) + gap)
	var img := Image.create(w, 10, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0.7))
	var full := Color("8fd16a") if is_soldier else Color("d65a4a")
	if is_soldier and float(hp) / max_hp <= 0.34:
		full = Palette.DANGER
	for i in max_hp:
		var col := full if i < hp else Color(0.25, 0.25, 0.25, 0.9)
		img.fill_rect(Rect2i(gap + i * (pip_w + gap), 2, pip_w, 6), col)
	_hp_sprite.texture = ImageTexture.create_from_image(img)


func _refresh_infection() -> void:
	_infection_ring.scale = Vector3(1, 0.3, 1)
	_infection_ring.visible = is_soldier and infection > 0 and not dead
	var col := Palette.tier_color(tier)
	_infection_mat.emission = col
	_infection_mat.emission_energy_multiplier = 0.6 + tier * 1.4 + infection * 0.01
	if not is_soldier:
		return
	var stage := Infection.Tier.TURNED if turned else tier
	for g in _growths:
		var n: Node3D = g[1]
		var show: bool = stage >= g[0]
		if show and not n.visible and g[0] > _shown_stage and is_inside_tree():
			n.scale = Vector3.ONE * 0.02   # pops in during pulse_infection
			_popping.append(n)
		n.visible = show
	_shown_stage = stage
	var k := 1.0 if turned else clampf(infection / 100.0, 0.0, 1.0)
	_set_veins(k if stage > 0 else 0.0)
	if _mats.has("visor"):
		_mats.visor.set_shader_parameter("emission_color", Palette.player_ui(owner_player).lerp(Palette.TEAL, k))
	if not turned:
		_glow.visible = tier >= 2
		_glow.light_energy = 0.35 * tier


func _refresh_status() -> void:
	var parts: PackedStringArray = []
	if lapsed:
		parts.append("LAPSED")
	if turned:
		parts.append("TURNED")
	if overwatch:
		parts.append("OVERWATCH")
	if hunkered:
		parts.append("HUNKERED")
	_status_label.text = " ".join(parts)
	_status_label.modulate = Palette.DANGER if (lapsed or turned) else Palette.AMBER
