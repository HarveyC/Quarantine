; Engine configuration file.
config_version=5

[application]

config/name="Quarantine"
config/description="Co-op tactics roguelike: Carriers in the Quarantine Zone."
run/main_scene="res://scenes/app.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

SettingsHost="*res://view/settings_host.gd"
Soundscape="*res://view/soundscape.gd"
UiFeel="*res://ui/ui_feel.gd"
Platform="*res://platform/platform.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true

[carriers]

steam/app_id=480
crash_reports/url=""
