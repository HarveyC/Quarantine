		"voice": "okafor"
	},
	{
		"file": "okafor_d50f016152.ogg",
		"text": "forty-two's",
		"voice": "okafor"
	},
	{
		"file": "okafor_d7ced28cc7.ogg",
		"text": "The wall crews' demolition rigs went quiet last week. One of them is moving again.",
		"voice": "okafor"
	},
	{
		"file": "okafor_d911b34823.ogg",
		"text": "Wave",
		"voice": "okafor"
	},
	{
		"file": "okafor_d98c1dc99c.ogg",
		"text": "Every power it gives you pulls you closer to the Source. Use them anyway.",
		"voice": "okafor"
	},
	{
		"file": "okafor_d9b7cfb6bd.ogg",
		"text": "That's the last sac. Light her up.",
		"voice": "okafor"
	},
	{
		"file": "okafor_d9f7aaa6a4.ogg",
		"text": "twenty-nine's",
		"voice": "okafor"
	},
	{
		"file": "okafor_da7ea4f101.ogg",
		"text": "fourteen's",
		"voice": "okafor"
	},
	{
		"file": "okafor_daec795696.ogg",
		"text": "twenty-five's",
		"voice": "okafor"
	},
	{
		"file": "okafor_db7ba4835d.ogg",
		"text": "Achebe's",
		"voice": "okafor"
	},
	{
		"file": "okafor_ddc9acfdb8.ogg",
		"text": "Iyer's",
		"voice": "okafor"
	},
	{
		"file": "okafor_ddea728b8d.ogg",
