		"voice": "okafor"
	},
	{
		"file": "okafor_cd4e204ea8.ogg",
		"text": "She's tunnelling! Watch the ground and get off the roofs.",
		"voice": "okafor"
	},
	{
		"file": "okafor_d03341a475.ogg",
		"text": "forty-seven",
		"voice": "okafor"
	},
	{
		"file": "okafor_d1183241d2.ogg",
		"text": "That's a nest. Burn it out before it spreads.",
		"voice": "okafor"
	},
	{
		"file": "okafor_d3d1a582b7.ogg",
		"text": "Nakamura",
		"voice": "okafor"
	},
	{
