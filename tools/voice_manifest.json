		"voice": "okafor"
	},
	{
		"file": "okafor_a1fe065cd0.ogg",
		"text": "never came back. Their lanterns are still moving out there.",
		"voice": "okafor"
	},
	{
		"file": "okafor_a2aeac37f9.ogg",
		"text": "seven's",
		"voice": "okafor"
	},
	{
		"file": "okafor_a63d963ac6.ogg",
		"text": "Everything past it belongs to the Bloom.",
		"voice": "okafor"
