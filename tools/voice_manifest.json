	},
	{
		"file": "source_1a415f5ae0.ogg",
		"text": "Rook",
		"voice": "source"
	},
	{
		"file": "source_1b6ecd67f8.ogg",
		"text": "Cruz",
		"voice": "source"
	},
	{
		"file": "source_1d377d3bc9.ogg",
		"text": "Cut my roots, and then we will talk.",
		"voice": "source"
	},
	{
		"file": "source_2126aaee90.ogg",
		"text": "Kowalski",
		"voice": "source"
	},
	{
		"file": "source_22d943c9e7.ogg",
		"text": "You're nearly home.",
		"voice": "source"
	},
	{
		"file": "source_23809d8d17.ogg",
		"text": "Ferreira",
		"voice": "source"
	},
	{
		"file": "source_25d6f2870a.ogg",
		"text": "Lindqvist",
		"voice": "source"
	},
	{
		"file": "source_28cca4f008.ogg",
		"text": "I know all of your names.",
		"voice": "source"
	},
	{
		"file": "source_29e7549cfd.ogg",
		"text": "Come down to me,",
		"voice": "source"
	},
	{
		"file": "source_3af30b2713.ogg",
		"text": "Brennan",
		"voice": "source"
	},
	{
		"file": "source_3afbb9fc02.ogg",
		"text": "Moreau",
		"voice": "source"
	},
	{
		"file": "source_3e785defc6.ogg",
		"text": "You came.",
		"voice": "source"
	},
	{
		"file": "source_430f293c7e.ogg",
		"text": "Every one of you is already part of me. Come down.",
		"voice": "source"
	},
	{
		"file": "source_4bd761d4cf.ogg",
		"text": "Tanaka",
		"voice": "source"
	},
	{
		"file": "source_5ad077bb30.ogg",
		"text": "Achebe",
		"voice": "source"
	},
	{
		"file": "source_5e99ac035f.ogg",
		"text": "Vasquez",
		"voice": "source"
	},
	{
		"file": "source_5fdfeb8c7a.ogg",
		"text": "They will burn you too, when this is over.",
		"voice": "source"
	},
	{
		"file": "source_69d13fa56b.ogg",
		"text": "Mercer",
		"voice": "source"
	},
	{
		"file": "source_6d693087da.ogg",
		"text": "Larsen",
		"voice": "source"
	},
	{
		"file": "source_734ffceeba.ogg",
		"text": "Sato",
		"voice": "source"
	},
	{
		"file": "source_74c0fa200d.ogg",
		"text": "Last time, you burned me. I grew back.",
		"voice": "source"
	},
	{
		"file": "source_9459b92017.ogg",
		"text": "Adeyemi",
		"voice": "source"
	},
	{
		"file": "source_9f55c0919e.ogg",
		"text": "Halloran",
		"voice": "source"
	},
	{
		"file": "source_a067db36ae.ogg",
		"text": "Whitlock",
		"voice": "source"
	},
	{
		"file": "source_a18ae8d5d6.ogg",
		"text": "I can feel you,",
		"voice": "source"
	},
	{
		"file": "source_a58b723a6e.ogg",
		"text": "That's me.",
		"voice": "source"
	},
