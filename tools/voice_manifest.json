[
	{
		"file": "hale_0d6ba12fc6.ogg",
		"text": "Lantern Company. You are carrying company property.",
		"voice": "hale"
	},
	{
		"file": "hale_0fd6b68e4f.ogg",
		"text": "Recovery team, move up.",
		"voice": "hale"
	},
	{
		"file": "hale_8bb1b076d1.ogg",
		"text": "Stand down and we'll take you home. In jars.",
		"voice": "hale"
	},
	{
		"file": "hale_a5727195bc.ogg",
		"text": "Take the carriers alive. The rest is optional.",
		"voice": "hale"
	},
	{
		"file": "hale_bb8ed61135.ogg",
		"text": "Keep them pinned. I want those samples intact.",
		"voice": "hale"
	},
	{
		"file": "hale_ebd64fe80c.ogg",
		"text": "Suppress them. Nobody leaves.",
		"voice": "hale"
	},
	{
		"file": "hale_turned_5ad8cfd184.ogg",
		"text": "Company property. All of it. All of us.",
		"voice": "hale_turned"
	},
	{
		"file": "hale_turned_b7d29a55bc.ogg",
		"text": "It's warm down here. Why is it so warm.",
		"voice": "hale_turned"
	},
	{
		"file": "hale_turned_fb6a947585.ogg",
		"text": "Stand down. Stand down. Come home.",
		"voice": "hale_turned"
	},
	{
		"file": "hv_02283fd9fa.ogg",
		"text": "I don't need all of you. I need one of you, breathing.",
		"voice": "hv"
	},
	{
		"file": "hv_09c10c3a8f.ogg",
		"text": "Sample secured. Your contracts are complete.",
		"voice": "hv"
	},
	{
		"file": "hv_2888f1a230.ogg",
		"text": "You are making this harder than it is.",
		"voice": "hv"
	},
	{
		"file": "hv_30a69eb444.ogg",
		"text": "My team will do the lifting. Please don't make it hard.",
		"voice": "hv"
	},
	{
		"file": "hv_5da9c55b9c.ogg",
		"text": "Lantern Company. Your blood work is under contract. Stay exactly where you are.",
		"voice": "hv"
	},
	{
		"file": "hv_6005de6d52.ogg",
		"text": "Collectors, the nearest one. Gently.",
		"voice": "hv"
	},
	{
		"file": "hv_716698149d.ogg",
		"text": "Hold your positions. Nobody touches the carriers.",
		"voice": "hv"
	},
	{
		"file": "hv_86fbe33c7a.ogg",
		"text": "Lantern Company. Please stay where you are.",
		"voice": "hv"
	},
	{
		"file": "hv_87136ac886.ogg",
		"text": "Cage the marked carrier. Now.",
		"voice": "hv"
	},
	{
		"file": "hv_984aa1c79e.ogg",
		"text": "Extraction is called. Everyone clear the lane.",
		"voice": "hv"
	},
	{
		"file": "hv_a87eb208ca.ogg",
		"text": "The colony was never the product.",
		"voice": "hv"
	},
	{
		"file": "hv_aa4dd0c66b.ogg",
		"text": "Posts, lock your lanes.",
		"voice": "hv"
	},
	{
		"file": "hv_ae046bbfac.ogg",
		"text": "Mark the warm one. The most Infected, I want that one.",
		"voice": "hv"
	},
	{
		"file": "hv_b33ce265e7.ogg",
		"text": "I only need one. One will do.",
		"voice": "hv"
	},
	{
		"file": "hv_b9a90e348e.ogg",
		"text": "Second team, take the roofs.",
		"voice": "hv"
	},
	{
		"file": "okafor_00401955df.ogg",
		"text": "Outbreak is climbing. The Bloom is moving faster than you are.",
		"voice": "okafor"
	},
	{
		"file": "okafor_01e5159ab0.ogg",
		"text": "fifty-one's",
		"voice": "okafor"
	},
	{
		"file": "okafor_053ec06c5e.ogg",
		"text": "thirty-eight's",
		"voice": "okafor"
	},
	{
		"file": "okafor_05571bdd7a.ogg",
		"text": "Lindqvist's",
		"voice": "okafor"
	},
	{
		"file": "okafor_094d90c768.ogg",
		"text": "eleven's",
		"voice": "okafor"
	},
	{
		"file": "okafor_0acd2100f8.ogg",
		"text": "The glow is spreading behind you. Don't stop.",
		"voice": "okafor"
	},
	{
		"file": "okafor_0d196b89b3.ogg",
		"text": "twenty-six's",
		"voice": "okafor"
	},
	{
		"file": "okafor_0e6fc146d3.ogg",
		"text": "Quinn",
		"voice": "okafor"
	},
	{
		"file": "okafor_102d76b781.ogg",
		"text": "Abara",
		"voice": "okafor"
	},
	{
		"file": "okafor_10575335e0.ogg",
		"text": "Abara's",
		"voice": "okafor"
	},
	{
		"file": "okafor_1162fc95f6.ogg",
		"text": "thirty-three's",
		"voice": "okafor"
	},
	{
		"file": "okafor_116e9394fc.ogg",
		"text": "fifty-five's",
		"voice": "okafor"
	},
	{
		"file": "okafor_121f10e6b2.ogg",
		"text": "She's lost it. No more sacs. Finish her.",
		"voice": "okafor"
	},
	{
		"file": "okafor_133a6bec4b.ogg",
		"text": "Haddad",
		"voice": "okafor"
	},
	{
		"file": "okafor_15f6f8dc03.ogg",
		"text": "twelve",
		"voice": "okafor"
	},
	{
		"file": "okafor_180de050b8.ogg",
		"text": "Duarte's",
		"voice": "okafor"
	},
	{
		"file": "okafor_193f784d56.ogg",
		"text": "Osei",
		"voice": "okafor"
	},
	{
		"file": "okafor_1a3161e2dd.ogg",
		"text": "thirty",
		"voice": "okafor"
	},
	{
		"file": "okafor_1a415f5ae0.ogg",
		"text": "Rook",
		"voice": "okafor"
	},
	{
		"file": "okafor_1b6e0f7a97.ogg",
		"text": "carrier is still down there, holding it shut. The Bore is quiet. Mostly.",
		"voice": "okafor"
	},
	{
		"file": "okafor_1b6ecd67f8.ogg",
		"text": "Cruz",
		"voice": "okafor"
	},
	{
		"file": "okafor_1bad62a81f.ogg",
		"text": "ten's",
		"voice": "okafor"
	},
	{
		"file": "okafor_1bbb81cb1c.ogg",
		"text": "Supply drop at the depot. Take what you need.",
		"voice": "okafor"
	},
	{
		"file": "okafor_1c6b89ab00.ogg",
		"text": "Quinn's",
		"voice": "okafor"
	},
	{
		"file": "okafor_1cda29ff44.ogg",
		"text": "Adeyemi's",
		"voice": "okafor"
	},
	{
		"file": "okafor_1d56cec552.ogg",
		"text": "nineteen",
		"voice": "okafor"
	},
	{
		"file": "okafor_1e2ec159ee.ogg",
		"text": "twelve's",
		"voice": "okafor"
	},
	{
		"file": "okafor_1f1105dc13.ogg",
		"text": "forty-five",
		"voice": "okafor"
	},
	{
		"file": "okafor_20d771c052.ogg",
		"text": "Break the egg sacs first. While they live, she can't be hurt.",
		"voice": "okafor"
	},
	{
		"file": "okafor_20db64405a.ogg",
		"text": "Signal's breaking up. The labs... Halden-Voss knew... don't trust...",
		"voice": "okafor"
	},
	{
		"file": "okafor_20f0d99417.ogg",
		"text": "fifty-three",
		"voice": "okafor"
	},
	{
		"file": "okafor_2126aaee90.ogg",
		"text": "Kowalski",
		"voice": "okafor"
	},
	{
		"file": "okafor_23809d8d17.ogg",
		"text": "Ferreira",
		"voice": "okafor"
	},
	{
		"file": "okafor_24d27c169c.ogg",
		"text": "eight",
		"voice": "okafor"
	},
	{
		"file": "okafor_25d6f2870a.ogg",
		"text": "Lindqvist",
		"voice": "okafor"
	},
	{
		"file": "okafor_26199193e4.ogg",
		"text": "twenty-six",
		"voice": "okafor"
	},
	{
		"file": "okafor_262b4120aa.ogg",
		"text": "twenty-five",
		"voice": "okafor"
	},
	{
		"file": "okafor_27232be292.ogg",
		"text": "Sato's",
		"voice": "okafor"
	},
	{
		"file": "okafor_279e962ea6.ogg",
		"text": "fourteen",
		"voice": "okafor"
	},
	{
		"file": "okafor_27b8eb6240.ogg",
		"text": "fifty's",
		"voice": "okafor"
	},
	{
		"file": "okafor_291d082d12.ogg",
		"text": "nineteen's",
		"voice": "okafor"
	},
	{
		"file": "okafor_293c9db342.ogg",
		"text": "We lost",
		"voice": "okafor"
	},
	{
		"file": "okafor_29fcb85392.ogg",
		"text": "Osei's",
		"voice": "okafor"
	},
	{
		"file": "okafor_2b2df99caa.ogg",
		"text": "is down. They're not getting up.",
		"voice": "okafor"
	},
	{
		"file": "okafor_2b54fd1b55.ogg",
		"text": "forty",
		"voice": "okafor"
	},
	{
		"file": "okafor_2ba5d47ba3.ogg",
		"text": "five's",
		"voice": "okafor"
	},
	{
		"file": "okafor_2c722001d1.ogg",
		"text": "The wall rig is running again, and nobody is driving it.",
		"voice": "okafor"
	},
	{
		"file": "okafor_2cbdaf9ce4.ogg",
		"text": "eighteen",
		"voice": "okafor"
	},
	{
		"file": "okafor_2d67c4a7ed.ogg",
		"text": "Its plate is off. It's tearing the yard down on top of you.",
		"voice": "okafor"
	},
	{
		"file": "okafor_2dd6f84b2c.ogg",
		"text": "Petrov's",
		"voice": "okafor"
	},
	{
		"file": "okafor_2e457d2f9f.ogg",
		"text": "seventeen",
		"voice": "okafor"
	},
	{
		"file": "okafor_2f9dab8efa.ogg",
		"text": "Civilians on thermals. Bring them home.",
		"voice": "okafor"
	},
	{
		"file": "okafor_2ffd56bc4e.ogg",
		"text": "forty-four's",
		"voice": "okafor"
	},
	{
		"file": "okafor_30056e1cab.ogg",
		"text": "five",
		"voice": "okafor"
	},
	{
		"file": "okafor_3016b74b0f.ogg",
		"text": "Medical tent ahead. Get the wounded seen to.",
		"voice": "okafor"
	},
	{
		"file": "okafor_30317a13ab.ogg",
		"text": "twenty-four's",
		"voice": "okafor"
	},
	{
		"file": "okafor_30ad4dc419.ogg",
		"text": "thirty's",
		"voice": "okafor"
	},
	{
		"file": "okafor_30d1ef7099.ogg",
		"text": "twenty-eight",
		"voice": "okafor"
	},
	{
		"file": "okafor_331102a21e.ogg",
		"text": "forty-one's",
		"voice": "okafor"
	},
	{
		"file": "okafor_336ae8a5a3.ogg",
		"text": "Hostiles on thermals. Your call how you go in.",
		"voice": "okafor"
	},
	{
		"file": "okafor_34b88f6d52.ogg",
		"text": "six's",
		"voice": "okafor"
	},
	{
		"file": "okafor_3559cd8996.ogg",
		"text": "sixty's",
		"voice": "okafor"
	},
	{
		"file": "okafor_35d6d33467.ogg",
		"text": "three",
		"voice": "okafor"
	},
	{
		"file": "okafor_36684da1b2.ogg",
		"text": "one's",
		"voice": "okafor"
	},
	{
		"file": "okafor_39d3d10611.ogg",
		"text": "thirty-six's",
		"voice": "okafor"
	},
	{
		"file": "okafor_3a7ae59743.ogg",
		"text": "Something up ahead. Eyes open.",
		"voice": "okafor"
	},
	{
		"file": "okafor_3af30b2713.ogg",
		"text": "Brennan",
		"voice": "okafor"
	},
	{
		"file": "okafor_3afbb9fc02.ogg",
		"text": "Moreau",
		"voice": "okafor"
	},
	{
		"file": "okafor_3c34acc2dd.ogg",
		"text": "forty-six's",
		"voice": "okafor"
	},
	{
		"file": "okafor_3d5d202592.ogg",
		"text": "thirty-one's",
		"voice": "okafor"
	},
	{
		"file": "okafor_3d5fbb101c.ogg",
		"text": "Cruz's",
		"voice": "okafor"
	},
	{
		"file": "okafor_3d8df2e61b.ogg",
		"text": "We can see the fire from the wall. Come home, Lanterns.",
		"voice": "okafor"
	},
	{
		"file": "okafor_3fbc25523d.ogg",
		"text": "twenty-seven's",
		"voice": "okafor"
	},
	{
		"file": "okafor_40009f14a7.ogg",
		"text": "tags recovered. Rest easy.",
		"voice": "okafor"
	},
	{
		"file": "okafor_40521ce366.ogg",
		"text": "Tanaka's",
		"voice": "okafor"
	},
	{
		"file": "okafor_40a15367ff.ogg",
		"text": "you're up.",
		"voice": "okafor"
	},
	{
		"file": "okafor_41165ed468.ogg",
		"text": "fifty-eight's",
		"voice": "okafor"
	},
	{
		"file": "okafor_422ecc084f.ogg",
		"text": "thirteen",
		"voice": "okafor"
	},
	{
		"file": "okafor_4368bc610a.ogg",
		"text": "thirty-four",
		"voice": "okafor"
	},
	{
		"file": "okafor_44d29acb85.ogg",
		"text": "thirty-five's",
		"voice": "okafor"
	},
	{
		"file": "okafor_4501ef4ace.ogg",
		"text": "That's what has been feeding on the camps.",
		"voice": "okafor"
	},
	{
		"file": "okafor_45becc00ca.ogg",
		"text": "forty-eight's",
		"voice": "okafor"
	},
	{
		"file": "okafor_4b92315c7d.ogg",
		"text": "is gone. That isn't them any more.",
		"voice": "okafor"
	},
	{
		"file": "okafor_4ba67ffbec.ogg",
		"text": "fifty-five",
		"voice": "okafor"
	},
	{
		"file": "okafor_4bd761d4cf.ogg",
		"text": "Tanaka",
		"voice": "okafor"
	},
	{
		"file": "okafor_4c33d2132b.ogg",
		"text": "fifteen's",
		"voice": "okafor"
	},
	{
		"file": "okafor_4dd8773d23.ogg",
		"text": "Survivors. Alive, for now.",
		"voice": "okafor"
	},
	{
		"file": "okafor_4ef0ea6610.ogg",
		"text": "thirty-seven's",
		"voice": "okafor"
	},
	{
		"file": "okafor_4ef1ab9bbd.ogg",
		"text": "Rook's",
		"voice": "okafor"
	},
	{
		"file": "okafor_52852120cc.ogg",
		"text": "Intel recovered.",
		"voice": "okafor"
	},
	{
		"file": "okafor_53da04b867.ogg",
		"text": "two's",
		"voice": "okafor"
	},
	{
		"file": "okafor_546e3c862e.ogg",
		"text": "It's stripped to the frame. Two runs at once, watch both lanes.",
		"voice": "okafor"
	},
	{
		"file": "okafor_5743867f3f.ogg",
		"text": "They aren't ours any more.",
		"voice": "okafor"
	},
	{
		"file": "okafor_593d0c47e9.ogg",
		"text": "Volkov's",
		"voice": "okafor"
	},
	{
		"file": "okafor_5ad077bb30.ogg",
		"text": "Achebe",
		"voice": "okafor"
	},
	{
		"file": "okafor_5c99060b4f.ogg",
		"text": "thirty-five",
		"voice": "okafor"
	},
	{
		"file": "okafor_5d4734079b.ogg",
		"text": "Contact. That's",
		"voice": "okafor"
	},
	{
		"file": "okafor_5e99ac035f.ogg",
		"text": "Vasquez",
		"voice": "okafor"
	},
	{
		"file": "okafor_5eb24b6aea.ogg",
		"text": "fifty-three's",
		"voice": "okafor"
	},
	{
		"file": "okafor_60a15bf871.ogg",
		"text": "Vasquez's",
		"voice": "okafor"
	},
	{
		"file": "okafor_612708cdb6.ogg",
		"text": "fifty-nine's",
		"voice": "okafor"
	},
	{
		"file": "okafor_6189c2e3fb.ogg",
		"text": "They've seen us.",
		"voice": "okafor"
	},
	{
		"file": "okafor_61a4999c5a.ogg",
		"text": "Kowalski's",
		"voice": "okafor"
	},
	{
		"file": "okafor_640b2ec045.ogg",
		"text": "Okafor's",
		"voice": "okafor"
	},
	{
		"file": "okafor_65fecb4411.ogg",
		"text": "Contacts ahead. Keep it tight.",
		"voice": "okafor"
	},
	{
		"file": "okafor_6672359670.ogg",
		"text": "is moving up to the line.",
		"voice": "okafor"
	},
	{
		"file": "okafor_683b898429.ogg",
		"text": "Through the breach, down the Bore. Burn the Source and come home.",
		"voice": "okafor"
	},
	{
		"file": "okafor_6954729b04.ogg",
		"text": "Depot's still stocked. Spend it before the Bloom does.",
		"voice": "okafor"
	},
	{
		"file": "okafor_69d13fa56b.ogg",
		"text": "Mercer",
		"voice": "okafor"
	},
	{
		"file": "okafor_6bbe0a55ca.ogg",
		"text": "turned. Don't hesitate.",
		"voice": "okafor"
	},
	{
		"file": "okafor_6be5f9d6d5.ogg",
		"text": "forty-six",
		"voice": "okafor"
	},
	{
		"file": "okafor_6d39f601c0.ogg",
		"text": "I know that one.",
		"voice": "okafor"
	},
	{
		"file": "okafor_6d693087da.ogg",
		"text": "Larsen",
		"voice": "okafor"
	},
	{
		"file": "okafor_6ded9e9198.ogg",
		"text": "nine's",
		"voice": "okafor"
	},
	{
		"file": "okafor_6f5de84e35.ogg",
		"text": "eighteen's",
		"voice": "okafor"
	},
	{
		"file": "okafor_70d4e89a04.ogg",
		"text": "Spore readings off the scale. That's a nest.",
		"voice": "okafor"
	},
	{
		"file": "okafor_7140cf4376.ogg",
		"text": "That's the last post. She has no cover. Go.",
		"voice": "okafor"
	},
	{
		"file": "okafor_734ffceeba.ogg",
		"text": "Sato",
		"voice": "okafor"
	},
	{
		"file": "okafor_743942eb54.ogg",
		"text": "fifty-four's",
		"voice": "okafor"
	},
	{
		"file": "okafor_75072b758f.ogg",
		"text": "She's marked one of you. Break her sight lines and keep that soldier moving.",
		"voice": "okafor"
	},
	{
		"file": "okafor_7565481bb4.ogg",
		"text": "forty-five's",
		"voice": "okafor"
	},
	{
		"file": "okafor_761329f955.ogg",
		"text": "Haddad's",
		"voice": "okafor"
	},
	{
		"file": "okafor_7700143085.ogg",
		"text": "You're past the wall. Port Ardent is ahead of you.",
		"voice": "okafor"
	},
	{
		"file": "okafor_784812c419.ogg",
		"text": "It flattens whatever is in its way. Don't stand behind anything you need.",
		"voice": "okafor"
	},
	{
		"file": "okafor_7ad0a2e1d9.ogg",
		"text": "Plate's gone. Get off the high ground.",
		"voice": "okafor"
	},
	{
		"file": "okafor_7b6ab2ee51.ogg",
		"text": "Whitlock's",
		"voice": "okafor"
	},
	{
		"file": "okafor_7b97285aa4.ogg",
		"text": "You are Lantern Company. You carry the Bloom, so it lets you walk where it lives.",
		"voice": "okafor"
	},
	{
		"file": "okafor_7ddf2bc107.ogg",
		"text": "She's coming straight at you. Put her down.",
		"voice": "okafor"
	},
	{
		"file": "okafor_7df215aef6.ogg",
		"text": "forty-nine",
		"voice": "okafor"
	},
	{
		"file": "okafor_808a8f5523.ogg",
		"text": "Mercer's",
		"voice": "okafor"
	},
	{
		"file": "okafor_84249807ef.ogg",
		"text": "Halden-Voss got its sample. Their shuttle left this morning. Nobody told us where.",
		"voice": "okafor"
	},
	{
		"file": "okafor_8484ed6ecb.ogg",
		"text": "Halloran's",
		"voice": "okafor"
	},
	{
		"file": "okafor_85414954fe.ogg",
		"text": "Movement on every side. It's a trap.",
		"voice": "okafor"
	},
	{
		"file": "okafor_85a82a559d.ogg",
		"text": "Sacs are down. She's open. Hit her now.",
		"voice": "okafor"
	},
	{
		"file": "okafor_85ed8467e3.ogg",
		"text": "seventeen's",
		"voice": "okafor"
	},
	{
		"file": "okafor_8602aa6a4c.ogg",
		"text": "twenty-one",
		"voice": "okafor"
	},
	{
		"file": "okafor_86b979c3b8.ogg",
		"text": "Picking up something strange. Go and look.",
		"voice": "okafor"
	},
	{
		"file": "okafor_87cb31913c.ogg",
		"text": "Big signature ahead. This is it.",
		"voice": "okafor"
	},
	{
		"file": "okafor_8854dba962.ogg",
		"text": "Larsen's",
		"voice": "okafor"
	},
	{
		"file": "okafor_8946033a79.ogg",
		"text": "You're past the wall. Port Ardent's harbour lights are on.",
		"voice": "okafor"
	},
	{
		"file": "okafor_896e67823d.ogg",
		"text": "twenty's",
		"voice": "okafor"
	},
	{
		"file": "okafor_89a0476e8a.ogg",
		"text": "twenty-three",
		"voice": "okafor"
	},
	{
		"file": "okafor_8af025b8fe.ogg",
		"text": "Nobody here turned them on. A Halden-Voss recovery team is on the docks. They are not here for the Infected.",
		"voice": "okafor"
	},
	{
		"file": "okafor_8bea065677.ogg",
		"text": "Mbeki's",
		"voice": "okafor"
	},
	{
		"file": "okafor_8cb8ea05b2.ogg",
		"text": "Moreau's",
		"voice": "okafor"
	},
	{
		"file": "okafor_8cbad96ace.ogg",
		"text": "four",
		"voice": "okafor"
	},
	{
		"file": "okafor_8ff5fa099c.ogg",
		"text": "forty-three",
		"voice": "okafor"
	},
	{
		"file": "okafor_92a2132e01.ogg",
		"text": "fifteen",
		"voice": "okafor"
	},
	{
		"file": "okafor_9459b92017.ogg",
		"text": "Adeyemi",
		"voice": "okafor"
	},
	{
		"file": "okafor_958d450b24.ogg",
		"text": "thirty-two's",
		"voice": "okafor"
	},
	{
		"file": "okafor_96def9efec.ogg",
		"text": "Put them down gently.",
		"voice": "okafor"
	},
	{
		"file": "okafor_97a9bccc3d.ogg",
		"text": "fifty",
		"voice": "okafor"
	},
	{
		"file": "okafor_98dc4e386a.ogg",
		"text": "fifty-nine",
		"voice": "okafor"
	},
	{
		"file": "okafor_99098a4f76.ogg",
		"text": "Field hospital. Patch up while you can.",
		"voice": "okafor"
	},
	{
		"file": "okafor_9c8454ddf7.ogg",
		"text": "eleven",
		"voice": "okafor"
	},
	{
		"file": "okafor_9c955f9f93.ogg",
		"text": "burned the Source. The drones already see regrowth.",
		"voice": "okafor"
	},
	{
		"file": "okafor_9f55c0919e.ogg",
		"text": "Halloran",
		"voice": "okafor"
	},
	{
