		"voice": "okafor"
	},
	{
		"file": "okafor_dfb03c9dea.ogg",
		"text": "twenty-eight's",
		"voice": "okafor"
	},
	{
		"file": "okafor_e0001e4aaf.ogg",
		"text": "Whatever is holding this district, it's right there.",
		"voice": "okafor"
	},
	{
		"file": "okafor_e039312ffc.ogg",
		"text": "Cages incoming. Don't let anyone stand pinned under one.",
		"voice": "okafor"
	},
	{
		"file": "okafor_e03b75c98d.ogg",
		"text": "Reyes's",
		"voice": "okafor"
	},
	{
		"file": "okafor_e1561a8f63.ogg",
		"text": "Novak",
		"voice": "okafor"
	},
	{
		"file": "okafor_e794f0d8ae.ogg",
		"text": "She's under you somewhere. Move when the ground cracks.",
		"voice": "okafor"
	},
	{
		"file": "okafor_e7ec4c603e.ogg",
		"text": "Reyes",
		"voice": "okafor"
	},
	{
		"file": "okafor_e8c5bf75ac.ogg",
		"text": "fifty-two's",
		"voice": "okafor"
	},
	{
		"file": "okafor_e97f3ebdf0.ogg",
		"text": "That was too quiet. Weapons up.",
		"voice": "okafor"
	},
	{
		"file": "okafor_ecb0b1874d.ogg",
		"text": "Infected in the street. Clear it and move on.",
		"voice": "okafor"
	},
	{
		"file": "okafor_ededcdf4fa.ogg",
		"text": "fifty-eight",
		"voice": "okafor"
	},
	{
