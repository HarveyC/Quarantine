		"text": "fifty-six's",
		"voice": "okafor"
	},
	{
		"file": "okafor_aed3dfe887.ogg",
		"text": "Port Ardent fell in eleven days. The wall has held for two hundred.",
		"voice": "okafor"
	},
	{
