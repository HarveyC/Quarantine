## Perk ids in a class's pool, in table order.
static func pool(kind: String) -> Array[String]:
	var out: Array[String] = []
	for id in PERKS:
		if PERKS[id]["class"] == kind:
			out.append(id)
	return out


static func passive(kind: String) -> Dictionary:
	return PASSIVES.get(kind, {})
